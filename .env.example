# Minecraft version applied to all Paper backends.
# Mojang's 2026+ scheme is YEAR.DROP[.PATCH] (e.g. 26.1.2); the older line was 1.21.x.
# LATEST = newest stable build.
# NOTE: 26.1+ requires Java 25 — keep the backend image pinned to a `*-java25` tag (see compose.yml).
MC_VERSION=26.1.2

# Server operators on every backend (comma-separated Minecraft usernames).
# Empty = no operators. e.g. OPS=Steve,Alex
OPS=

# Timezone for container log timestamps (IANA name). Defaults to UTC if unset.
# e.g. TZ=Asia/Tokyo
TZ=UTC

# MOTD shown in the multiplayer server list (the proxy's MOTD — the only one
# players see). MiniMessage tags allowed, e.g. <#09add3>text</#09add3>.
# Unset/empty falls back to "A Minecraft Server" (see compose.yml).
PROXY_MOTD=<#09add3>My Minecraft Server</#09add3>

# Plugins are declared per backend: comma-separated Modrinth project slugs,
# resolved against TYPE+VERSION at boot. Removing one makes itzg delete it.
# Unset falls back to the compose.yml defaults (same values as below).
# Notes on the creative defaults (building tools stay off lobby/survival):
# - fastasyncworldedit bundles WorldEdit (needs Java 21+, satisfied by java25).
# - axiom-paper-plugin is only the serverside half: players also need the Axiom
#   CLIENT mod + op/axiom.default perm, and MULTIPLAYER USE REQUIRES a commercial
#   license or a whitelist from the Axiom Discord.
LOBBY_MODRINTH_PROJECTS=
SURVIVAL_MODRINTH_PROJECTS=
CREATIVE_MODRINTH_PROJECTS=fastasyncworldedit,axiom-paper-plugin

# Plugins on the Velocity proxy: comma-separated Modrinth project slugs,
# resolved against the proxy's velocity loader + MC_VERSION at boot.
# Unset falls back to the compose.yml default (same value as below).
PROXY_MODRINTH_PROJECTS=viaversion,viabackwards

# RCON commands run once each time a backend finishes starting, one command per
# line inside the double quotes. Unset/empty = run nothing. NOTE: since MC
# 1.21.11 (26.x) gamerules use snake_case registry names — old camelCase names
# (doMobSpawning, ...) fail silently in the startup loop. Also, EssentialsX
# overrides /time and /weather and requires an explicit world name when run
# from RCON (treated as console) — "world" is Paper's default world name.
# Lobby hub behaviour: no mob spawning, frozen daytime/weather, spawn at 0,0,0.
LOBBY_RCON_CMDS_STARTUP="gamerule spawn_mobs false
gamerule advance_time false
gamerule advance_weather false
time set day world
weather world sun
setworldspawn 0 0 0"
# Creative: pin the spawn to the superflat surface at 0,0,0.
CREATIVE_RCON_CMDS_STARTUP="setworldspawn 0 0 0"

# Backup sidecars (one per backend, itzg/mc-backup): how often to pause saves,
# tar /data, and resume, using mc-backup's duration syntax (e.g. 2h, 1.5d).
# Unset falls back to the compose.yml default (same value as below).
BACKUP_INTERVAL=24h

# Backup sidecars: delete backups under ./backups/<name> older than this many
# days. Unset falls back to the compose.yml default (same value as below).
PRUNE_BACKUPS_DAYS=7
