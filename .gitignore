# --- secrets (never commit) ---
/secrets/forwarding.secret
/secrets/rcon.secret
.env

# --- live config materialized from *.example (holds the injected secret) ---
servers/*/config/paper-global.yml

# --- local-only compose overrides (e.g. temporary resource trims) ---
compose.override.yml
compose.override.yaml

# --- runtime data: worlds, logs, plugins, live config, server jars (bind-mounted /data) ---
servers/*/data/

# --- backup archives written by the mc-backup sidecars ---
/backups/
